# Copy this file to .env.local and fill in values.
# Restart `npm run dev` after changes.

# --- Dealer portal (Supabase) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Server-side catalog, coupons, inventory (Render / local Express)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Google Analytics 4 ---
VITE_GA_MEASUREMENT_ID=G-C881TN39BC
GA_PROPERTY_ID=123456789
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- Checkout & dealer registration API ---
# Local dev: Vite runs on port 8080 and proxies /api to Express on 3001
VITE_API_URL=http://localhost:8080

# Production example:
# VITE_API_URL=https://your-backend.onrender.com
