# GunTab API Configuration
# Get your API tokens from: https://www.guntab.com/account/api

# Simulated token (for testing - transactions won't actually process)
GUNTAB_API_TOKEN_SIMULATED=your_simulated_token_here

# Live token (for production - real transactions)
GUNTAB_API_TOKEN_LIVE=your_live_token_here

# GunTab API URL (usually no need to change)
GUNTAB_API_URL=https://api.guntab.com/v1

# Server Configuration
PORT=3001
NODE_ENV=development

# Note: When NODE_ENV=production, the server will use GUNTAB_API_TOKEN_LIVE
# Otherwise, it uses GUNTAB_API_TOKEN_SIMULATED

