# Authorize.net API Configuration
# Get your API credentials from: Account → Settings → API Credentials & Keys

# API Login ID (from Authorize.net dashboard)
AUTHORIZENET_API_LOGIN_ID=your_api_login_id_here

# Transaction Key (from Authorize.net dashboard)
AUTHORIZENET_TRANSACTION_KEY=your_transaction_key_here

# Environment (sandbox for testing, production for live)
AUTHORIZENET_ENVIRONMENT=sandbox

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Note: 
# - Use 'sandbox' environment for testing
# - Switch to 'production' when you enable Transaction Processing Mode
# - Test card numbers: https://developer.authorize.net/hello_world/testing_guide/
